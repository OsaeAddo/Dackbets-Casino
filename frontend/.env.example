# Copy this file to frontend/.env.local for local development.
# NEXT_PUBLIC_* values are exposed to the browser, so never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Comma-separated extra origins allowed to load Next.js dev resources (HMR and
# client chunks) when the dev server is opened from another host, e.g. a phone
# or another machine on the LAN. Use the host only, without scheme or port.
# Without this, React never hydrates on that origin.
# ALLOWED_DEV_ORIGINS=192.168.1.20
