# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# Application JWT. Use a long random value in any shared environment.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: the primary frontend origin plus optional comma-separated extras.
FRONTEND_URL=http://localhost:3000
# FRONTEND_URLS=https://app.example.com,https://staging.example.com

# Optional development email settings
EMAIL_DEV_MODE=true
EMAIL_DEV_DIR=./email_logs

# Set DEBUG=true only for local development.
DEBUG=false

# Security
# Shared secret required by /api/admin/* (sent as X-Admin-Key). Leave empty to
# disable the admin API entirely.
ADMIN_API_KEY=
# HMAC secret for inbound webhooks (Tatum x-payload-hash or X-Webhook-Signature).
# Leave empty to refuse signed webhooks (the endpoint returns 503).
WEBHOOK_HMAC_SECRET=
# Enable the /api/webhooks/test/* simulator. Never enable in production.
ENABLE_TEST_WEBHOOKS=false
